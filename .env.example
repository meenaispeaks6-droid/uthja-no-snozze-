# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: Your Supabase Project URL (configured via Secrets panel or .env)
SUPABASE_URL=https://placeholder.supabase.co

# SUPABASE_ANON_KEY: Your Supabase Project Anonymous API Key (configured via Secrets panel or .env)
SUPABASE_ANON_KEY=placeholder-anon-key

# GOOGLE_WEB_CLIENT_ID: Your Web Client ID from Firebase / Google Cloud console
# (Optional if google-services.json is added to /app, or provide here)
GOOGLE_WEB_CLIENT_ID=placeholder_google_web_client_id
